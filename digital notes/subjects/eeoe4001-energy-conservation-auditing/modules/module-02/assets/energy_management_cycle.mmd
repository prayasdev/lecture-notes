flowchart LR
    A[Make commitment] --> B[Assess performance]
    B --> C[Set goals]
    C --> D[Create action plan]
    D --> E[Implement plan]
    E --> F[Monitor and evaluate]
    F --> G[Recognize achievements]
    G --> A

    classDef step fill:#e8f1f8,stroke:#24557a,stroke-width:1.2px,color:#102a43;
    class A,B,C,D,E,F,G step;
